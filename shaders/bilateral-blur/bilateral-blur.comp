#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D source;                 // r = value, g = linear depth (nearest sampler)
layout(set = 0, binding = 1, rg16f) uniform writeonly image2D outputTex;

layout(push_constant) uniform PC {
    ivec2 size;
    int   radius;     
    float depthSigma;   
} pc;


void main() {
      ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.size))) return;


    vec2 c= texelFetch(source, p,0).rg;
    if(c.g > 1e5) {
        imageStore(outputTex, p, vec4(1.0f, c.g, 0.0f, 0.0f));
        return;
    }
}